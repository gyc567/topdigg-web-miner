# ============================================================
# Creator Hub - Bitable Configuration
# ============================================================
# Copy this file to .env.local and fill in the values.
# DO NOT commit .env.local to version control.

# ── Feishu App Credentials ────────────────────────────────────
# Get these from: https://open.feishu.cn/ → Developer Console → Your App
VITE_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
VITE_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Bitable App Token ─────────────────────────────────────────
# The app_token of the "创作者资料库" Bitable app.
# Found in the Bitable URL: https://xxx.feishu.cn/base/{APP_TOKEN}?table=xxx
VITE_CREATORS_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Bitable Table IDs ────────────────────────────────────────
# The table_id of each table (found in Bitable URL ?table=xxx)
VITE_CREATORS_TABLE_ID=tblXXXXXXXXXXXXXX
VITE_ACCOUNTS_TABLE_ID=tblXXXXXXXXXXXXXX
VITE_CASES_TABLE_ID=tblXXXXXXXXXXXXXX

# ── Notification (optional) ───────────────────────────────────
# Send a Feishu DM to this user Open ID when new creator submits
VITE_NOTIFY_USER_OPEN_ID=
