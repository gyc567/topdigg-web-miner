# TopDigg — site-wide environment template.
# Copy to `.env.local` for dev; for prod set in Vercel project environment.

# Paddle (paywall) — see src/lib/paddle-config.ts
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_MONTHLY=pri_ml_monthly
VITE_PADDLE_PRICE_YEARLY=pri_ml_yearly
VITE_PADDLE_PRICE_SINGLE=pri_ml_single
VITE_PAY_DOMAIN=https://pay.topdigg.com

# Supabase (paywall — anonymous key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics & Search Console — see src/components/Analytics.tsx
# Leave empty in dev to suppress scripts. Set in Vercel prod.
#
# Google Analytics 4 measurement ID, looks like: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=
#
# Microsoft Clarity project ID (from clarity.microsoft.com → Settings → Setup)
VITE_CLARITY_PROJECT_ID=
#
# Google Search Console verification token
# (Search Console → Settings → Ownership → HTML tag → content="<token>")
VITE_GSC_VERIFICATION_ID=
