# TopDigg — site-wide environment template.
# Copy to `.env.local` for dev; for prod set in Vercel project environment.

# Dodo Payments (paywall) — see api/checkout.ts and src/lib/dodo-config.ts
#
# The API key is a SERVER-side secret: no VITE_ prefix, so Vite never inlines
# it into the client bundle. The browser only ever sends a plan slug; the
# server maps it to an allowlisted product id.
#
# Test mode and live mode share nothing — keys, products, customers and
# webhook secrets are all separate. Use a `dodo_test_` key locally.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Webhook signing secret — from Dodo dashboard: Developer > Webhooks > Create
# Webhook. Base64 payload after the `whsec_` prefix. Test and live have
# separate secrets.
DODO_PAYMENTS_WEBHOOK_KEY=

# plan slug → Dodo product id (server-side allowlist)
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
DODO_PRODUCT_SINGLE=

# Client-safe: the browser only needs to know which mode is in use.
VITE_DODO_ENVIRONMENT=test_mode

# Public site origin, used to build the checkout return URL.
# Falls back to the request host when unset.
SITE_URL=https://www.topdigg.com

# Supabase (auth — anonymous key only; not wired up yet)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics & Search Console — see src/components/Analytics.tsx
# Leave empty in dev to suppress scripts. Set in Vercel prod.
#
# Google Analytics 4 measurement ID, looks like: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=
#
# Microsoft Clarity project ID (from clarity.microsoft.com → Settings → Setup)
VITE_CLARITY_PROJECT_ID=
#
# Google Search Console verification token
# (Search Console → Settings → Ownership → HTML tag → content="<token>")
VITE_GSC_VERIFICATION_ID=

# Database — Neon in production (use the pooler connection string), local
# Postgres works for development.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated extra origins allowed to call the auth API (production domains).
BETTER_AUTH_TRUSTED_ORIGINS=

# Credit entitlement id (balance checks / redemptions)
DODO_CREDIT_ENTITLEMENT_ID=
